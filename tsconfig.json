{
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "preserve",
    "noEmit": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2020",
    "verbatimModuleSyntax": true
  },
  "include": [
    "src",
    "stories",
    ".storybook",
    "tsdown.config.ts",
    "vitest.config.ts",
    "vitest.setup.ts"
  ]
}
